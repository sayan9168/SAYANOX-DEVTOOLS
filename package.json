{
  "name": "sayanox-devtools",
  "displayName": "SAYANOX DevTools",
  "description": "A powerful, local-first VS Code developer toolkit for code analysis, security scanning, project health, and developer productivity.",
  "version": "0.1.0",
  "publisher": "SAYANOX",
  "license": "Apache-2.0",
  "repository": {"type":"git","url":"https://github.com/sayan9168/SAYANOX-DEVTOOLS.git"},
  "engines": {"vscode": "^1.92.0"},
  "categories": ["Other","Linters","Testing"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {"command":"sayanox.analyzeFile","title":"SAYANOX: Analyze Current File","category":"SAYANOX"},
      {"command":"sayanox.securityScan","title":"SAYANOX: Security Scan","category":"SAYANOX"},
      {"command":"sayanox.projectHealth","title":"SAYANOX: Project Health","category":"SAYANOX"},
      {"command":"sayanox.askLocalAI","title":"SAYANOX: Ask Local AI","category":"SAYANOX"}
    ],
    "configuration": {
      "title":"SAYANOX DevTools",
      "properties": {
        "sayanox.ollama.enabled":{"type":"boolean","default":false,"description":"Enable the optional local Ollama assistant."},
        "sayanox.ollama.model":{"type":"string","default":"gemma:1b","description":"Ollama model used by the local assistant."},
        "sayanox.ollama.endpoint":{"type":"string","default":"http://127.0.0.1:11434","description":"Local Ollama endpoint."}
      }
    }
  },
  "scripts": {
    "compile":"tsc -p ./",
    "watch":"tsc -watch -p ./",
    "check":"tsc --noEmit -p ./",
    "package":"npm run compile && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node":"^22.0.0",
    "@types/vscode":"^1.92.0",
    "typescript":"^5.6.3",
    "@vscode/vsce":"^3.2.2"
  }
}